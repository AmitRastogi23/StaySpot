<% layout("/layout/boilerplate") -%>
<body>
  <div class="listing-form-wrapper">
    <div class="listing-form-card">
      <h1>Edit Your Listing</h1>
      <p class="listing-form-subtext">Update the details of your listing</p>

      <form
        action="http://localhost:8080/listings/<%=result._id%>?_method=PATCH"
        method="post"
        novalidate
        class="needs-validation"
        enctype="multipart/form-data"
      >
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input
            type="text"
            value="<%=result.title%>"
            name="title"
            class="form-control"
          />
          <div class="invalid-feedback">Enter a valid title.</div>
        </div>

        <div class="mb-3">
          <label for="Desc" class="form-label">Description</label>
          <textarea name="description" id="Desc" class="form-control" required><%=result.description%></textarea
          >
          <div class="invalid-feedback">Enter a valid description.</div>
        </div>

        <div class="mb-3">
          <label for="img" class="form-label">Upload New Listing Image</label>
          <input
            type="file"
            name="image"
            id="msg"
            class="form-control"
          />
        </div>

        <div class="row">
          <div class="mb-3 col-md-4">
            <label for="price" class="form-label">Price</label>
            <input
              type="number"
              name="price"
              id="price"
              value="<%=result.price%>"
              class="form-control"
              required
            />
            <div class="invalid-feedback">Enter a valid price.</div>
          </div>

          <div class="mb-3 col-md-8">
            <label for="country" class="form-label">Country</label>
            <input
              type="text"
              name="country"
              id="country"
              value="<%=result.country%>"
              class="form-control"
              required
            />
            <div class="invalid-feedback">Enter a valid country name.</div>
          </div>
        </div>

        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
          <input
            type="text"
            name="location"
            id="location"
            value="<%=result.location%>"
            class="form-control"
            required
          />
          <div class="invalid-feedback">Enter a valid location.</div>
        </div>

        <button type="submit" class="btn edit-btn">Save Changes</button>
      </form>
    </div>
  </div>
</body>
