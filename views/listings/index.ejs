<% layout("/layout/boilerplate") -%>
<body>
    <div id="filters" class="mt-2">
        <div class="filters-scroll">
            <div class="filter active">
                <div><i class="fa-solid fa-fire"></i></div>
                <p>Trending</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-couch"></i></div>
                <p>Rooms</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-sailboat"></i></div>
                <p>Boats</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-earth-oceania"></i></div>
                <p>Islands</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-mountain-city"></i></div>
                <p>Iconic Cities</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-mountain"></i></div>
                <p>Mountains</p>
            </div>
            <div class="filter">
                <div><i class="fa-brands fa-fort-awesome"></i></div>
                <p>Castles</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-person-swimming"></i></div>
                <p>Amazing Pools</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-campground"></i></div>
                <p>Camping</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-wheat-awn"></i></div>
                <p>Farms</p>
            </div>
            <div class="filter">
                <div><i class="fa-solid fa-snowman"></i></div>
                <p>Arctic</p>
            </div>
        </div>

        <div class="tax-toggle">
            <i class="fa-solid fa-receipt"></i>
            <div class="form-check-reverse form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
            <label class="form-check-label" for="switchCheckDefault">Show total after taxes</label>
            </div>
        </div>
    </div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
        <% for(let row of result) { %>
            <a href="/listings/<%=row._id%>" class="listing-links">
              <div class="card listing-card">
                <img src="<%=row.image%>" class="card-img-top" alt="Listing_image">
                <div class="card-body">
                    <h5 class="card-title mt-2"><%= row.title %></h5>
                    <p class="card-desc"><%= row.description %></p>
                    <p class="card-price mb-0">
                      &#x20B9; <%=row.price.toLocaleString("en-IN")%> / night
                      <i class="switch tax-info">&nbsp;&nbsp;+18% GST</i>
                    </p>
                </div>
              </div>
            </a>
        <% } %>
    </div>
</body>
